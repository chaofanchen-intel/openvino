+// Same idea for uncompressed (f16/f32 weight) FCs, targeting the Q/K/V projections: three bias-free FCs that read one
+// activation become a single FC over concatenated weights followed by a VariadicSplit (lowered to in-place crops).
+// One GEMM with a 4x larger N runs closer to peak than three small ones and reads the activation once.
+class FullyConnectedUncompressedHorizontalFusion: public ov::pass::MatcherPass {
+public:
+    OPENVINO_MATCHER_PASS_RTTI("FullyConnectedUncompressedHorizontalFusion");
+    FullyConnectedUncompressedHorizontalFusion();
+};
+
 }   // namespace ov::intel_gpu
