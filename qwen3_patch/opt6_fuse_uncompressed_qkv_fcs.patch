+// Build input[-1, 7, 1024] -> n_fcs FullyConnected (f16 weights, one per entry of `n_sizes`) -> Results and run the pass.
+// Returns the transformed model.
+std::shared_ptr<ov::Model> run_uncompressed_fusion(const std::vector<size_t>& n_sizes, bool constant_weights, bool with_bias) {
+    auto input = std::make_shared<ov::op::v0::Parameter>(ov::element::f16, ov::PartialShape{-1, 7, 1024});
+    ov::ParameterVector params{input};
+    ov::ResultVector results;
+    for (auto n : n_sizes) {
+        std::shared_ptr<ov::Node> weight;
+        if (constant_weights) {
+            weight = std::make_shared<ov::op::v0::Constant>(ov::element::f16, ov::Shape{n, 1024});
+        } else {
+            auto p = std::make_shared<ov::op::v0::Parameter>(ov::element::f16, ov::Shape{n, 1024});
+            params.push_back(p);
+            weight = p;
+        }
+        std::shared_ptr<ov::Node> bias = std::make_shared<ov::intel_gpu::op::Placeholder>();
+        if (with_bias)
+            bias = std::make_shared<ov::op::v0::Constant>(ov::element::f16, ov::Shape{1, 1, n});
+        auto fc = std::make_shared<ov::intel_gpu::op::FullyConnected>(input, weight, bias);
+        results.push_back(std::make_shared<ov::op::v0::Result>(fc));
+    }
+    auto model = std::make_shared<ov::Model>(results, params);
+    ov::pass::Manager manager;
+    manager.register_pass<FullyConnectedUncompressedHorizontalFusion>();
+    manager.run_passes(model);
+    return model;
+}
+
+size_t count_ops(const std::shared_ptr<ov::Model>& model, const ov::DiscreteTypeInfo& type) {
+    const auto ops = model->get_ops();
+    return std::count_if(ops.begin(), ops.end(), [&](const std::shared_ptr<ov::Node>& n) {
+        return n->get_type_info() == type;
+    });
+}
+
+}  // namespace
+
+TEST(FullyConnectedUncompressedHorizontalFusion, qkv_projections_are_fused) {
+    auto model = run_uncompressed_fusion({2048, 1024, 512}, true, false);
+    ASSERT_EQ(count_ops(model, ov::intel_gpu::op::FullyConnected::get_type_info_static()), 1u);
+    ASSERT_EQ(count_ops(model, ov::op::v1::VariadicSplit::get_type_info_static()), 1u);
+    const auto ops = model->get_ops();
+    for (const auto& node : ops) {
+        if (auto fc = ov::as_type_ptr<ov::intel_gpu::op::FullyConnected>(node)) {
+            // Concatenated along N, contraction dimension untouched, output [-1, 7, 2048 + 1024 + 512].
+            ASSERT_EQ(fc->get_input_shape(1), (ov::Shape{2048 + 1024 + 512, 1024}));
+            ASSERT_EQ(fc->get_output_partial_shape(0), (ov::PartialShape{-1, 7, 2048 + 1024 + 512}));
+        }
+        if (auto split = ov::as_type_ptr<ov::op::v1::VariadicSplit>(node)) {
+            std::vector<size_t> shapes;
+            for (const auto& out : split->outputs())
+                shapes.push_back(out.get_partial_shape()[2].get_length());
+            std::sort(shapes.begin(), shapes.end());
+            ASSERT_EQ(shapes, (std::vector<size_t>{512, 1024, 2048}));
+        }
+    }
+    // Every original Result still has the right width.
+    std::vector<size_t> widths;
+    for (const auto& r : model->get_results())
+        widths.push_back(r->get_input_partial_shape(0)[2].get_length());
+    std::sort(widths.begin(), widths.end());
+    ASSERT_EQ(widths, (std::vector<size_t>{512, 1024, 2048}));
+}
+
+TEST(FullyConnectedUncompressedHorizontalFusion, two_projections_are_not_fused) {
+    auto model = run_uncompressed_fusion({3072, 3072}, true, false);  // gate/up: a split on the innermost axis costs a copy
+    ASSERT_EQ(count_ops(model, ov::intel_gpu::op::FullyConnected::get_type_info_static()), 2u);
+    ASSERT_EQ(count_ops(model, ov::op::v1::VariadicSplit::get_type_info_static()), 0u);
+}
+
+TEST(FullyConnectedUncompressedHorizontalFusion, non_constant_weights_are_not_fused) {
+    auto model = run_uncompressed_fusion({2048, 1024, 1024}, false, false);
+    ASSERT_EQ(count_ops(model, ov::intel_gpu::op::FullyConnected::get_type_info_static()), 3u);
+    ASSERT_EQ(count_ops(model, ov::op::v1::VariadicSplit::get_type_info_static()), 0u);
+}
+
+TEST(FullyConnectedUncompressedHorizontalFusion, projections_with_bias_are_not_fused) {
+    auto model = run_uncompressed_fusion({2048, 1024, 1024}, true, true);
+    ASSERT_EQ(count_ops(model, ov::intel_gpu::op::FullyConnected::get_type_info_static()), 3u);
+    ASSERT_EQ(count_ops(model, ov::op::v1::VariadicSplit::get_type_info_static()), 0u);
+}
+
+TEST(FullyConnectedUncompressedHorizontalFusion, compressed_fcs_are_left_to_the_compressed_pass) {
+    auto input = std::make_shared<ov::op::v0::Parameter>(ov::element::f16, ov::PartialShape{-1, 7, 1024});
+    ov::ResultVector results;
+    for (size_t n : {2048, 1024, 1024}) {
+        auto weight = std::make_shared<ov::op::v0::Constant>(ov::element::u8, ov::Shape{n, 1024});
+        auto bias = std::make_shared<ov::intel_gpu::op::Placeholder>();
+        auto scale = std::make_shared<ov::op::v0::Constant>(ov::element::f16, ov::Shape{n, 1});
+        auto fc = std::make_shared<ov::intel_gpu::op::FullyConnectedCompressed>(input, weight, bias, scale);
+        results.push_back(std::make_shared<ov::op::v0::Result>(fc));
+    }
+    auto model = std::make_shared<ov::Model>(results, ov::ParameterVector{input});
+    ov::pass::Manager manager;
+    manager.register_pass<FullyConnectedUncompressedHorizontalFusion>();
+    manager.run_passes(model);
+    ASSERT_EQ(count_ops(model, ov::op::v1::VariadicSplit::get_type_info_static()), 0u);
+}
