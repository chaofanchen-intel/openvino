+FullyConnectedUncompressedHorizontalFusion::FullyConnectedUncompressedHorizontalFusion() {
+    using namespace ov::pass::pattern;
+
+    constexpr size_t num_fcs_to_fuse = 3;
+
+    // FullyConnectedCompressed derives from FullyConnected; those are handled by FullyConnectedHorizontalFusion.
+    auto as_plain_fc = [](const std::shared_ptr<ov::Node>& node) -> std::shared_ptr<op::FullyConnected> {
+        if (ov::is_type<op::FullyConnectedCompressed>(node))
+            return nullptr;
+        return ov::as_type_ptr<op::FullyConnected>(node);
+    };
+
+    // The matched FC and all of its siblings reading the same activation (in graph order).
+    auto collect_siblings = [=](const std::shared_ptr<op::FullyConnected>& fc) {
+        std::vector<std::shared_ptr<op::FullyConnected>> fcs;
+        for (const auto& target : fc->input_value(0).get_target_inputs()) {
+            if (auto user = as_plain_fc(target.get_node()->shared_from_this()); user && target.get_index() == 0)
+                fcs.push_back(user);
+        }
+        return fcs;
+    };
+
+    auto is_target_pattern = [=](const Output<Node>& output) {
+        const auto fc = as_plain_fc(output.get_node_shared_ptr());
+        if (!fc || !fc->get_input_partial_shape(0).is_dynamic())
+            return false;
+        const auto fcs = collect_siblings(fc);
+        if (fcs.size() != num_fcs_to_fuse)
+            return false;
+        // The concatenated weights are folded at compile time, so they must be plain constants; no bias.
+        return std::all_of(fcs.begin(), fcs.end(), [](const std::shared_ptr<op::FullyConnected>& user) {
+            return ov::is_type<ov::op::v0::Constant>(user->get_input_node_shared_ptr(1)) &&
+                   ov::is_type<op::Placeholder>(user->get_input_node_shared_ptr(2));
+        });
+    };
+
+    auto target_fc = wrap_type<op::FullyConnected>(is_target_pattern);
+
+    ov::matcher_pass_callback callback = [=](Matcher& m) {
+        const auto matched = as_plain_fc(m.get_pattern_value_map().at(target_fc).get_node_shared_ptr());
+        if (!matched)
+            return false;
+        const auto fc_nodes = collect_siblings(matched);
+        if (fc_nodes.size() != num_fcs_to_fuse)
+            return false;
+
+        const bool transpose_b = fc_nodes[0]->get_transpose_b();
+        const size_t n_axis = transpose_b ? 0 : 1;
+        const size_t k_axis = transpose_b ? 1 : 0;
+        const auto weight_type = fc_nodes[0]->get_input_element_type(1);
+        const auto output_type = fc_nodes[0]->get_output_type();
+        if (fc_nodes[0]->get_input_shape(1).size() != 2)
+            return false;
+        const auto k_size = fc_nodes[0]->get_input_shape(1)[k_axis];
+
+        ov::OutputVector weights;
+        ov::NodeVector fc_nodes_vec;
+        std::vector<int64_t> n_sizes;
+        for (const auto& fc : fc_nodes) {
+            if (fc->get_input_element_type(1) != weight_type || fc->get_transpose_b() != transpose_b || fc->get_output_type() != output_type ||
+                fc->get_input_shape(1).size() != 2 || fc->get_input_shape(1)[k_axis] != k_size)
+                return false;
+            weights.push_back(fc->input_value(1));
+            fc_nodes_vec.push_back(fc);
+            n_sizes.push_back(static_cast<int64_t>(fc->get_input_shape(1)[n_axis]));
+        }
+
+        auto fused_weight = std::make_shared<ov::op::v0::Concat>(weights, n_axis);
+        fused_weight->set_friendly_name(fc_nodes[0]->get_input_node_shared_ptr(1)->get_friendly_name() + "_fused_weight");
+        ov::copy_runtime_info(fc_nodes_vec, fused_weight);
+
+        auto new_fc = std::make_shared<op::FullyConnected>(matched->input_value(0), fused_weight, std::make_shared<op::Placeholder>(), output_type, transpose_b);
+        new_fc->set_friendly_name(fc_nodes[0]->get_friendly_name() + "_fused_" + std::to_string(fc_nodes.size()) + "FCs");
+        ov::copy_runtime_info(fc_nodes_vec, new_fc);
+
+        auto axis_const = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {new_fc->get_output_partial_shape(0).size() - 1});
+        auto split_const = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{fc_nodes.size()}, n_sizes);
+        auto output_split = std::make_shared<ov::op::v1::VariadicSplit>(new_fc, axis_const, split_const);
+        output_split->set_friendly_name(fc_nodes[0]->get_friendly_name() + "_split");
+        ov::copy_runtime_info(fc_nodes_vec, output_split);
+
+        for (size_t i = 0; i < fc_nodes.size(); ++i) {
+            for (const auto& target : fc_nodes[i]->output(0).get_target_inputs())
+                target.replace_source_output(output_split->output(i));
+            fc_nodes[i]->clear_control_dependencies();
+        }
+        GPU_DEBUG_TRACE_DETAIL << "Created a new fused uncompressed FC " << new_fc->get_friendly_name() << std::endl;
+        return true;
+    };
+
+    auto m = std::make_shared<ov::pass::pattern::Matcher>(target_fc, "FullyConnectedUncompressedHorizontalFusion");
+    this->register_matcher(m, callback);
+}
+
 }  // namespace ov::intel_gpu
