-    // Do not skip dynamic quantization if any user node is not fully connected.(such as SDPA)
+    // Normally a DynamicQuantize feeds exactly one FullyConnected, which consumes every
+    // DQ output (quantized data + scale[+zp]), so users.size() == outputs_count.
+    // When several FullyConnected that share the same activation reuse a single DQ
+    // (e.g. q/k/v/z or gate/up projections), users.size() == outputs_count * num_consumers.
+    // Skipping is still valid in that case - the DQ becomes an f16 pass-through that every
+    // consumer reads identically. Require the user count to be a whole number of full
+    // consumers and that all of them are fully_connected (skipping is a no-op only for the
+    // FC f16 path).
+    const size_t outs = node.get_outputs_count();
+    OPENVINO_ASSERT(outs > 0 && node.get_users().size() % outs == 0,
+                    "Dynamic quantization users are not a whole multiple of its outputs: ", node.id());
     for (const auto& user : node.get_users()) {
         if (!user->is_type<fully_connected>())
             return false;
     }
