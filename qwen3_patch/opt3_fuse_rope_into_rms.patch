+// Fold `rms -> rope` (RotateHalf) into a single rms that rotates in its epilogue.
+//
+// Why. Qwen3 normalizes per attention head and then immediately rotates the same
+// [tokens, heads, head_size] tensor, so the activation is streamed twice for two
+// cheap elementwise passes. Both kernels sit at the DRAM ceiling on an iGPU, so
+// their cost is the bytes they move: read x / write normalized, then read
+// normalized / write rotated. Folding removes the middle tensor entirely.
+//
+// The fold is only legal for the plain RotateHalf form and only when the RMS
+// dispatch gives one sub-group per row with SUBGROUP_BLOCK_SIZE == items_num.
+// rms_gpu_bfyx_opt picks lws so that each work item handles ~8 elements, so a
+// head_size of SUB_GROUP_SIZE * 8 == 128 yields lws == 16 (one sub-group) and
+// items_num == SUBGROUP_BLOCK_SIZE == 8. Under exactly that shape, data[j] is
+// the element at j*SUB_GROUP_SIZE + lane, so RoPE's partner element j + 4 lives
+// in the same lane and no cross-lane exchange is needed. Any other head_size is
+// left alone.
+void prepare_primitive_fusing::fuse_rope_into_rms(program& p) {
+    if (std::getenv("OV_DISABLE_ROPE_RMS_FUSION"))
+        return;
+    auto itr = p.get_processing_order().begin();
+    while (itr != p.get_processing_order().end()) {
+        auto node = *itr++;
+        if (!node->is_type<rope>() || node->is_output())
+            continue;
+
+        auto& rope_node = node->as<rope>();
+        auto rope_prim = rope_node.get_primitive();
+        const auto& cfg = rope_prim->config;
+
+        // Plain RotateHalf only: no model-specific variant, no gather, no slice,
+        // no transpose, and the rotation must cover the whole head.
+        if (cfg.is_qwen || cfg.is_chatglm || cfg.is_ltx_video || cfg.is_interleaved ||
+            cfg.input_trans0213 || cfg.output_trans0213 || cfg.support_2d_rope || cfg.support_3d_rope)
+            continue;
+        if (rope_prim->gather_rank > 0 || cfg.slice_stop > cfg.slice_start)
+            continue;
+        if (cfg.head_size != 0 && cfg.head_size != cfg.rotary_ndims)
+            continue;
+        // cos/sin are indexed with a single offset in the folded kernel, which
+        // requires the "second half" offset to be exactly half the rotation.
+        if (cfg.rotary_ndims == 0 || (cfg.rotary_ndims % 2) != 0)
+            continue;
+        const size_t half_rotary = cfg.rotary_ndims / 2;
+        const size_t cos_sin_offset = (cfg.cos_sin_ndims == half_rotary) ? 0 : half_rotary;
+        if (cos_sin_offset != half_rotary)
+            continue;
+        // data[j] <-> data[j + SUBGROUP_BLOCK_SIZE/2] pairing, see the comment above.
+        constexpr size_t kSubGroupSize = 16;
+        constexpr size_t kItemsPerWorkItem = 8;
+        if (cfg.rotary_ndims != kSubGroupSize * kItemsPerWorkItem)
+            continue;
+        if (rope_node.has_fused_primitives() || rope_node.get_dependencies().size() != 3)
+            continue;
+
+        // The graph keeps a rank-fixing Reshape between the normalization and the
+        // rotation. It is a no-op in memory (it never touches the innermost axis),
+        // so walk through any chain of single-user Reshapes to find the rms.
+        program_node* producer = &rope_node.get_dependency(0);
+        bool reshape_chain_ok = true;
+        while (producer->is_type<reshape>()) {
+            if (producer->get_users().size() != 1 || producer->is_output() ||
+                producer->get_output_layout().data_padding ||
+                producer->get_input_layouts()[0].data_padding) {
+                reshape_chain_ok = false;
+                break;
+            }
+            const auto rs_in = producer->get_input_layouts()[0].get_partial_shape();
+            const auto rs_out = producer->get_output_layout().get_partial_shape();
+            if (rs_in.rank().is_dynamic() || rs_out.rank().is_dynamic() || rs_in.size() == 0 || rs_out.size() == 0 ||
+                rs_in[rs_in.size() - 1].is_dynamic() || rs_out[rs_out.size() - 1].is_dynamic() ||
+                rs_in[rs_in.size() - 1] != rs_out[rs_out.size() - 1]) {
+                reshape_chain_ok = false;
+                break;
+            }
+            producer = &producer->get_dependency(0);
+        }
+        if (!reshape_chain_ok)
+            continue;
+
+        auto& rms_node = *producer;
+        if (!rms_node.is_type<rms>() || rms_node.is_output() || rms_node.get_users().size() != 1 ||
+            rms_node.has_fused_primitives())
+            continue;
+
+        auto rms_prim = std::const_pointer_cast<rms>(rms_node.as<rms>().get_primitive());
+        if (rms_prim->fused_rope || !rms_prim->elementwise_affine || rms_node.get_dependencies().size() != 2)
+            continue;
+
+        // Everything stays f16: the kernel block-reads cos/sin with the INPUT0
+        // reader and evaluates the rotation in the input type to match rope_opt.
+        const auto in_layout = rms_node.get_input_layouts()[0];
+        const auto gamma_layout = rms_node.get_input_layouts()[1];
+        const auto cos_layout = rope_node.get_input_layouts()[1];
+        const auto sin_layout = rope_node.get_input_layouts()[2];
+        const auto out_layout = rope_node.get_output_layout();
+        if (in_layout.data_type != data_types::f16 || gamma_layout.data_type != data_types::f16 ||
+            cos_layout.data_type != data_types::f16 || sin_layout.data_type != data_types::f16 ||
+            rms_node.get_output_layout().data_type != data_types::f16 || out_layout.data_type != data_types::f16)
+            continue;
+        if (in_layout.format != format::bfyx || out_layout.format != format::bfyx)
+            continue;
+
+        // The normalized axis has to be the innermost one and match the rotation,
+        // and gamma has to cover it exactly (it is block-read as one row).
+        const auto in_pshape = in_layout.get_partial_shape();
+        if (in_pshape.rank().is_dynamic() || in_pshape.size() < 2)
+            continue;
+        const auto& last_dim = in_pshape[in_pshape.size() - 1];
+        if (last_dim.is_dynamic() || static_cast<size_t>(last_dim.get_length()) != cfg.rotary_ndims)
+            continue;
+        if (gamma_layout.is_dynamic() || gamma_layout.count() != cfg.rotary_ndims)
+            continue;
+
+        // The kernel recovers the token index as row_index / head_count, where the
+        // row index enumerates every [.., head_size] row in layout order. The heads
+        // are therefore *all* the axes between the batch and the normalized one --
+        // Qwen3 lands them in Y (e.g. [tokens, 1, 16, 128]), not in F -- so the head
+        // count is their product, and every one of them has to be static.
+        if (in_pshape.size() < 3)
+            continue;
+        size_t head_count = 1;
+        bool head_dims_static = true;
+        for (size_t i = 1; i + 1 < in_pshape.size(); i++) {
+            if (in_pshape[i].is_dynamic()) {
+                head_dims_static = false;
+                break;
+            }
+            head_count *= static_cast<size_t>(in_pshape[i].get_length());
+        }
+        if (!head_dims_static || head_count == 0)
+            continue;
+        // Rows are addressed flat as data_idx * data_size, so padding would break
+        // the row -> offset mapping the fused epilogue relies on.
+        if (in_layout.data_padding || out_layout.data_padding)
+            continue;
+
+        // cos/sin are read as cos[token * rotary_ndims + r], so the table must be
+        // one contiguous row per token.
+        // The tables are indexed cos[token * rotary_ndims + r], so only the
+        // innermost axis has to be known; the token count may stay dynamic. Every
+        // outer axis must be 1 so that rows are contiguous and one row per token.
+        auto cos_sin_row_ok = [&](const layout& l) {
+            if (l.data_padding)
+                return false;
+            const auto ps = l.get_partial_shape();
+            if (ps.rank().is_dynamic() || ps.size() == 0)
+                return false;
+            if (ps[ps.size() - 1].is_dynamic() ||
+                static_cast<size_t>(ps[ps.size() - 1].get_length()) != cfg.rotary_ndims)
+                return false;
+            for (size_t i = 1; i + 1 < ps.size(); i++) {
+                if (ps[i].is_dynamic() || ps[i].get_length() != 1)
+                    return false;
+            }
+            return true;
+        };
+        if (!cos_sin_row_ok(cos_layout) || !cos_sin_row_ok(sin_layout))
+            continue;
+        if (cos_layout.format != format::bfyx || sin_layout.format != format::bfyx)
+            continue;
+
+        auto& cos_node = rope_node.get_dependency(1);
+        auto& sin_node = rope_node.get_dependency(2);
+
+        rms_prim->fused_rope = true;
+        rms_prim->rope_half_rotary_ndims = half_rotary;
+        rms_prim->rope_cos_sin_table_offset = cos_sin_offset;
+        rms_prim->rope_head_count = head_count;
+        rms_prim->input.push_back(input_info(cos_node.id()));
+        rms_prim->input.push_back(input_info(sin_node.id()));
+
+        p.add_connection(cos_node, rms_node);
+        p.add_connection(sin_node, rms_node);
+
+        // program::extract() bypasses a node by wiring its single dependency to
+        // its users and refuses outright when there is more than one, so the
+        // cos/sin edges have to go first -- they now belong to the rms.
+        p.remove_connection(cos_node, rope_node);
+        p.remove_connection(sin_node, rope_node);
+        const bool removed = p.extract_and_remove(rope_node);
+        OPENVINO_ASSERT(removed, "[fuse_rope_into_rms] failed to remove ", rope_node.id(),
+                        " after folding it into ", rms_prim->id);
+        rms_node.recalc_output_layouts(false);
+
+        GPU_DEBUG_TRACE << "[fuse_rope_into_rms] folded " << rope_prim->id << " into " << rms_prim->id << std::endl;
+    }
+}
