--- a/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/dynamic_quantize_gpu_opt.cl
+++ b/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/dynamic_quantize_gpu_opt.cl
@@ -11,6 +11,11 @@
 #include "include/f8_utils.cl"
 #endif
 
+#if FUSE_RMS
