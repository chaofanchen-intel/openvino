+#endif
+
 REQD_SUB_GROUP_SIZE(SIMD)
 KERNEL(dynamic_quantize_gpu_opt)(
     OPTIONAL_SHAPE_INFO_ARG
     const __global INPUT0_TYPE* input,
+#if FUSE_RMS
+    const __global INPUT1_TYPE* gamma,
+#endif
     __global OUTPUT_TYPE* output,
     __global OUTPUT1_TYPE* output_scale
 #if ASYMMETRIC_QUANTIZATION
@@ -196,8 +215,11 @@ KERNEL(dynamic_quantize_gpu_opt)(
 #endif
     const uint offset = b_offset + VEC_SIZE * sglid;
 
-#if BLOCKS_PER_GROUP > 1
+#if FUSE_RMS || BLOCKS_PER_GROUP > 1
     const uint local_id = get_local_id(1);
+#endif
+
+#if BLOCKS_PER_GROUP > 1
     __local half local_mem_max[BLOCK_NUM];
     __local half local_mem_min[BLOCK_NUM];
     FOR_PRECOMPUTED_REDUCTION(__local int local_mem_reduction[BLOCK_NUM]);
@@ -210,12 +232,46 @@ KERNEL(dynamic_quantize_gpu_opt)(
     half max_value = 0.0h;
     half min_value = 0.0h;
     
+#if FUSE_RMS
+    // Folded RMSNorm of the whole row (one work-group = one row, one sub-group = one 128-element block). The operation order
+    // is the one of rms_gpu_bfyx_opt: strided sub-group block reads, per-work-item sum of squares in f32, sub-group reduce,
+    // SLM tree over the sub-group partials, rsqrt, then f32 (rms * x * gamma) rounded to f16. The normalized f16 value is what
+    // the separate rms primitive used to write and this kernel used to read, so the quantized result is bit-identical.
+    __local float rms_slm[RMS_SUB_GROUP_NUM];
+    const half8 x_raw = BLOCK_READN(half, 8, input, b_offset + local_id * block_size);
+    float rms_ss = 0.0f;
+    unroll_for (int j = 0; j < VEC_SIZE; j++) {
+        const float t = convert_float(x_raw[j]);
+        rms_ss += native_powr(t, 2);
+    }
+    rms_ss = sub_group_reduce_add(rms_ss);
+    if (sglid == 0)
+        rms_slm[local_id] = rms_ss;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    const uint rms_lin = local_id * SIMD + sglid;
+    for (uint rms_off = RMS_SUB_GROUP_NUM / 2; rms_off > 0; rms_off /= 2) {
+        if (rms_lin < rms_off)
+            rms_slm[rms_lin] += rms_slm[rms_lin + rms_off];
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (rms_lin == 0) {
+        const float mean_sq = rms_slm[0] / RMS_DATA_SIZE;
+        rms_slm[0] = native_powr(sqrt(mean_sq + RMS_EPSILON), -1);
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+    const float rms_inv = rms_slm[0];
+    const half8 gamma_raw = BLOCK_READN(half, 8, gamma, local_id * block_size);
+    unroll_for (int j = 0; j < VEC_SIZE; j++) {
+        val[j] = convert_half(rms_inv * convert_float(x_raw[j]) * convert_float(gamma_raw[j]));
+    }
+#else
     if (is_valid_block) {
         val = AS_INPUT_TYPE_N(VLOAD_N(0, input + input_offset + (blockid * block_size)));
     } else {
         // Initialize with zero for skipped blocks  
         val = (MAKE_VECTOR_TYPE(INPUT0_TYPE, VEC_SIZE))(0);
     }
+#endif
 
 #if ASYMMETRIC_QUANTIZATION
     if (is_valid_block) {
@@ -297,6 +353,9 @@ KERNEL(dynamic_quantize_gpu_opt)(
         val *= scale;
         val += zp;
         VSTORE_N(CAT(CONVERT_UCHAR_N, _rte)(val), 0, output + output_offset + (blockid * block_size));
+#elif FUSE_RMS // i8 symmetric, elements held in the strided sub-group block layout
+        val *= scale;
+        BLOCK_WRITEN(char, 8, output, output_offset - VEC_SIZE * sglid, CAT(CONVERT_CHAR_N, _rte)(val));
 #else // i8 symmetric
