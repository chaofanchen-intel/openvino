index cbbd34c..e2157f9 100644
--- a/src/plugins/intel_gpu/src/graph/graph_optimizer/prepare_primitive_fusing.cpp
+++ b/src/plugins/intel_gpu/src/graph/graph_optimizer/prepare_primitive_fusing.cpp
@@ -8,6 +8,7 @@
 #include "pooling_inst.h"
 #include "proposal_inst.h"
 #include "roi_pooling_inst.h"
+#include "dynamic_quantize_inst.h"
 #include "quantize_inst.h"
 #include "activation_inst.h"
 #include "batch_to_space_inst.h"
@@ -89,6 +90,124 @@ void prepare_primitive_fusing::run(program& p) {
     fuse_simple_primitives(p);
     fuse_constant_transposes(p);
     optimize_fused_ops(p);
+    fuse_rms_into_dynamic_quantize(p);
+}
+
+// Fold `rms -> dynamic_quantize` into a single dynamic_quantize that normalizes internally.
+//
+// Why. On a bandwidth-limited iGPU both primitives run at the DRAM ceiling, so their cost is
+// simply the bytes they move. The pair currently moves, per [T, H] f16 activation:
+//     rms:  read T*H*2 (x)          + write T*H*2 (normalized f16)
+//     dq:   read T*H*2 (normalized) + write T*H   (s8) + scales
+// The middle f16 tensor is written once and read straight back, purely to hand the value from
+// one kernel to the next. Folding rms into dq removes both of those passes -- 2*T*H*2 bytes per
+// site -- leaving read x / write s8. For Qwen3.5-2B at a 1k prefill this pattern occurs on the
+// input_layernorm and post_attention_layernorm of all 24 decoder layers; 47 of those 48 sites
+// match (layer 0's input_layernorm keeps a second consumer of the normalized tensor, so its rms
+// has to stay), which at 1002x2048 f16 removes ~385 MB of DRAM traffic from the prefill.
+//
+// Bit-exactness. The fused kernel reproduces rms_gpu_bfyx_opt's reduction *structure* exactly
+// (see dynamic_quantize_gpu_opt.cl, MODE_LARGE_GS / FUSE_RMS), and rounds the normalized value
+// to f16 before quantizing, which is what the standalone dynamic_quantize used to read. The
+// quantized output is therefore bit-identical to the un-fused graph, not merely close.
+//
+// Decode. dynamic_quantize normally turns itself into an f16 pass-through for small batches
+// (should_skip_execution), which the decode phase relies on. A fused node cannot do that: its
+// input is the un-normalized activation, so aliasing output to input would silently drop the
+// normalization. Serving both forms from one node would need the output data type to flip
+// i8 <-> f16 at runtime, which a single shape-agnostic compiled kernel cannot do, so fused nodes
+// simply never skip -- see the fused_rms guards in dynamic_quantize_inst::should_skip_execution
+// and primitive_inst::update_shape. The cost is that the folded sites keep quantizing at batch 1;
+// that is a fraction of a percent of TPOT, but it does perturb the decode numerics of those
+// layers relative to the un-fused graph (prefill stays bit-exact).
+void prepare_primitive_fusing::fuse_rms_into_dynamic_quantize(program& p) {
+    auto itr = p.get_processing_order().begin();
+    while (itr != p.get_processing_order().end()) {
+        auto node = *itr++;
+        if (!node->is_type<dynamic_quantize>() || node->is_output())
+            continue;
+
+        auto& dq_node = node->as<dynamic_quantize>();
+        auto dq_prim = std::const_pointer_cast<dynamic_quantize>(dq_node.get_primitive());
+        if (dq_prim->fused_rms || dq_node.has_fused_primitives() || dq_node.get_dependencies().size() != 1)
+            continue;
+
+        auto& rms_node = dq_node.get_dependency(0);
+        if (!rms_node.is_type<rms>() || rms_node.is_output() || rms_node.get_users().size() != 1)
+            continue;
+
+        auto rms_prim = rms_node.as<rms>().get_primitive();
+        // Only the affine form is folded: the kernel always applies gamma, and a gamma-less rms
+        // would need a second kernel variant for no additional traffic saving.
+        if (!rms_prim->elementwise_affine || rms_node.get_dependencies().size() != 2)
+            continue;
+
+        // The fused kernel reads x and writes s8 in one pass, so both must be plain f16 buffers.
+        if (rms_node.get_input_layouts()[0].data_type != data_types::f16 ||
+            rms_node.get_output_layout().data_type != data_types::f16 ||
+            dq_node.get_input_layouts()[0].data_type != data_types::f16)
+            continue;
+
+        // Everything below mirrors DynamicQuantizeKernelOpt's FUSE_RMS preconditions. It has to:
+        // the folded form is implemented by that one kernel only, and the ref/kv-cache kernels
+        // refuse it rather than silently quantize an un-normalized activation. So a node fused
+        // here that the kernel then rejects leaves the selector with no candidate at all and the
+        // model fails to compile. Only properties that cannot change after this pass are used --
+        // primitive attributes and the (static) reduction extent -- so the mirror stays valid.
+        using QuantizationType = ov::op::internal::DynamicQuantize::QuantizationType;
+        const auto& attrs = dq_prim->attrs;
+        if (attrs.quantization_type != QuantizationType::Symmetric || attrs.quantization_dt != data_types::i8)
+            continue;
+
+        // One 128-element quantization group per sub-group (SIMD 16 x VEC_SIZE 8) along the last
+        // axis, which is the only shape the fused branch of the kernel emits. Note this excludes
+        // the per-token mode the plugin picks by default on systolic hardware.
+        if (attrs.group_sizes.empty() || attrs.group_sizes.back() != 128)
+            continue;
+        if (std::any_of(attrs.group_sizes.begin(), std::prev(attrs.group_sizes.end()), [](uint64_t g) { return g != 1; }))
+            continue;
+        if (!attrs.scales_zp_output_order.empty()) {
+            bool identity = true;
+            for (size_t i = 0; i < attrs.scales_zp_output_order.size(); i++)
+                identity &= attrs.scales_zp_output_order[i] == i;
+            if (!identity)
+                continue;
+        }
+
+        // The RMS reduction spans the whole row inside a single work-group, so the row length must
+        // be known now, be a whole number of 128-element groups, and fit the kernel's 32-sub-group
+        // work-group cap.
+        const auto& x_pshape = rms_node.get_input_layouts()[0].get_partial_shape();
+        if (x_pshape.rank().is_dynamic() || x_pshape.size() == 0 || x_pshape[x_pshape.size() - 1].is_dynamic())
+            continue;
+        const auto row_size = static_cast<size_t>(x_pshape[x_pshape.size() - 1].get_length());
+        if (row_size % 128 != 0 || row_size / 128 > 32 || ((row_size / 128) & (row_size / 128 - 1)) != 0)
+            continue;
+
+        auto& x_node = rms_node.get_dependency(0);
+        auto& gamma_node = rms_node.get_dependency(1);
+
+        // gamma has to cover the reduction axis exactly; the kernel block-reads it as one row.
+        const auto gamma_layout = gamma_node.get_output_layout();
+        if (gamma_layout.is_dynamic() || gamma_layout.count() != row_size ||
+            gamma_layout.data_type != data_types::f16)
+            continue;
+
+        dq_prim->fused_rms = true;
+        dq_prim->rms_eps = rms_prim->epsilon;
+        dq_prim->input = { input_info(x_node.id()), input_info(gamma_node.id()) };
+
+        p.remove_connection(rms_node, dq_node);
+        p.add_connection(x_node, dq_node);
+        p.add_connection(gamma_node, dq_node);
+        if (p.remove_if_dangling(rms_node))
+            p.add_optimized_primitive_info(rms_prim->id, {dq_prim->id});
+
+        dq_node.recalc_output_layouts(false);
+
+        GPU_DEBUG_TRACE << "[fuse_rms_into_dynamic_quantize] folded " << rms_prim->id << " into " << dq_prim->id
+                        << std::endl;
+    }
 }
 
