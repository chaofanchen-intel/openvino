+    auto gamma_mem = engine.allocate_memory({ov::Shape{1, 2048}, data_types::f16, format::bfyx});
+    set_values(x_mem, to_f16(rg.generate_random_1d<float>(ov::shape_size(x_shape), -8.0f, 8.0f)));
+    set_values(gamma_mem, to_f16(rg.generate_random_1d<float>(2048, 0.1f, 2.0f)));
+
