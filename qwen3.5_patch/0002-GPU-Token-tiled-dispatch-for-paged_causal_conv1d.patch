--- a/src/plugins/intel_gpu/src/graph/impls/ocl_v2/paged_causal_conv1d_ref.cl
+++ b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/paged_causal_conv1d_ref.cl
@@ -4,6 +4,38 @@
 
 #include "include/batch_headers/common.cl"
 
+// Token-tiled causal conv1d.
+//
+// Background. The original reference kernel dispatched GWS={seq_count, hidden_size}
+// and each work-item walked the whole sequence serially (for t in [0, seq_tokens)).
+// During prefill seq_count==1, so only `hidden_size` work-items run. That leaves the
+// dispatch work-size-limited: it cannot fill the device's hardware-thread budget, so
+// occupancy (and throughput) is capped well below 100%.
+//
+// A fully token-parallel dispatch (one work-item per output token, each rebuilding its
+// own K-element window from global memory) reaches full occupancy but multiplies global
+// reads by ~K and becomes memory-bound, which can be a net regression on a
+// bandwidth-limited integrated GPU. This kernel is the middle ground.
+//
+// Split each sequence's tokens into TOKEN_GROUPS (G) contiguous tiles and dispatch
+// GWS={seq_count, hidden_size, G}. Each (seq, h, g) work-item processes ONE tile of
+// ~ceil(seq_tokens/G) tokens SERIALLY with a sliding window exactly like the original
+// kernel — so within a tile there is NO redundant re-reading (streaming reuse is
+// preserved). The only extra reads are the K-1 history elements each tile needs to prime
+// its window at its tile start: hidden_size*G*(K-1) reads total (negligible), not
+// hidden_size*total_tokens*K. Multiplying the work-item count by G lifts occupancy back
+// toward full without the fully-token-parallel variant's memory blow-up. G is chosen
+// adaptively by the host (see the .cpp dispatch); this kernel is correct for any G>=1
+// (G=1 reduces exactly to the original serial kernel).
+//
+// Correctness: the per-output-element fma order is byte-identical to the serial version
+// (a tile computes the same sliding window the serial loop held at those t). Each tile
+// primes state[] from: input_embeds for sequence-relative idx>=0, else the initial
+// conv_state_table history slot (KERNEL_SIZE+idx) — the same window contents the serial
+// loop would have held, just reconstructed once per tile instead of carried token by
+// token. State write-back (interval boundaries + last token) is owned by exactly one
+// tile (contiguous, non-overlapping token ranges) so writes never race.
+
 // Optional fused SWISH (SiLU) epilogue.
 //
 // Qwen3.5 / Gated-DeltaNet always applies SiLU to this conv's output, and
@@ -55,6 +87,7 @@ KERNEL(paged_causal_conv1d_ref)
  int output_token_stride,
  int output_hidden_stride,
  int num_blocks,
+ int token_groups,
  int input_offset,
  int state_offset,
  int weight_offset,
@@ -78,8 +111,9 @@ KERNEL(paged_causal_conv1d_ref)
 
     const int seq = (int)get_global_id(0);
     const int h = (int)get_global_id(1);
+    const int g = (int)get_global_id(2);
 
-    if (seq >= seq_count || h >= hidden_size)
+    if (seq >= seq_count || h >= hidden_size || g >= token_groups)
         return;
 
     const int token_begin = subsequence_begins[seq];
@@ -93,8 +127,18 @@ KERNEL(paged_causal_conv1d_ref)
     const int seq_tokens = token_end - token_begin;
     const int block_span = blk_end - blk_begin;
 
+    // This work-item owns tile [tile_start, tile_end) of the sequence's tokens.
+    const int tile = (seq_tokens + token_groups - 1) / token_groups;
+    const int tile_start = g * tile;
+    if (tile_start >= seq_tokens)
+        return;
+    int tile_end = tile_start + tile;
+    if (tile_end > seq_tokens)
+        tile_end = seq_tokens;
+
+    // Degenerate cases: write zeros for this tile (matches the serial reference) and bail.
     if (blk_end <= blk_begin || block_span <= 1) {
-        for (int t = 0; t < seq_tokens; t++) {
+        for (int t = tile_start; t < tile_end; t++) {
             const int out_off = (token_begin + t) * output_token_stride + h * output_hidden_stride;
             output_embeds[out_off] = TO_OUTPUT_TYPE(0.0f);
         }
@@ -103,7 +147,7 @@ KERNEL(paged_causal_conv1d_ref)
 
     const int read_physical_block = block_indices[blk_begin];
     if (read_physical_block < 0 || read_physical_block >= num_blocks) {
-        for (int t = 0; t < seq_tokens; t++) {
+        for (int t = tile_start; t < tile_end; t++) {
             const int out_off = (token_begin + t) * output_token_stride + h * output_hidden_stride;
             output_embeds[out_off] = TO_OUTPUT_TYPE(0.0f);
         }
@@ -113,11 +157,24 @@ KERNEL(paged_causal_conv1d_ref)
     const int seq_interval = cache_interval[seq];
     const int prev_nums = (seq_interval > 0) ? (past_lens[seq] % seq_interval) : 0;
 
-    float state[KERNEL_SIZE];
-
     const int read_state_base = read_physical_block * state_block_stride + h * state_hidden_stride;
+
+    // Prime the sliding window for this tile: state[k] must equal the serial state[]
+    // just before processing token tile_start. That window ends at sequence-relative
+    // index (tile_start - 1); state[k] corresponds to idx = tile_start - KERNEL_SIZE + k.
+    //   idx >= 0 -> input_embeds[token_begin + idx]
+    //   idx  < 0 -> initial conv_state_table history slot (KERNEL_SIZE + idx)
+    // (For g==0, tile_start==0 so all idx<0 -> reads only the initial state, identical
+    //  to the original kernel's state init. Done once per tile, not per token.)
+    float state[KERNEL_SIZE];
     for (int k = 0; k < KERNEL_SIZE; k++) {
-        state[k] = convert_float(conv_state_table[read_state_base + k * state_kernel_stride]);
+        const int idx = tile_start - KERNEL_SIZE + k;
+        if (idx >= 0) {
+            const int in_off = (token_begin + idx) * input_token_stride + h * input_hidden_stride;
+            state[k] = convert_float(input_embeds[in_off]);
+        } else {
+            state[k] = convert_float(conv_state_table[read_state_base + (KERNEL_SIZE + idx) * state_kernel_stride]);
+        }
     }
 
     float bias_val = 0.0f;
@@ -125,7 +182,9 @@ KERNEL(paged_causal_conv1d_ref)
     bias_val = convert_float(conv_bias[h * bias_hidden_stride]);
 #endif
 
-    for (int t = 0; t < seq_tokens; t++) {
+    const int w_base = h * weight_hidden_stride;
+
+    for (int t = tile_start; t < tile_end; t++) {
         const int token_idx = token_begin + t;
 
         for (int k = 0; k + 1 < KERNEL_SIZE; k++) {
@@ -136,7 +195,6 @@ KERNEL(paged_causal_conv1d_ref)
         state[KERNEL_SIZE - 1] = convert_float(input_embeds[in_off]);
 
         float sum = bias_val;
-        const int w_base = h * weight_hidden_stride;
         for (int k = 0; k < KERNEL_SIZE; k++) {
             sum = fma(state[k], convert_float(conv_weight[w_base + k * weight_kernel_stride]), sum);
         }
