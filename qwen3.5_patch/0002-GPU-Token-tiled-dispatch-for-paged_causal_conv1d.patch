@@ -4,6 +4,9 @@
 
 #include "paged_causal_conv1d_ref.hpp"
 
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
 #include <limits>
 
 #include "intel_gpu/primitives/activation.hpp"
@@ -28,6 +31,7 @@ enum class ScalarArg : size_t {
     output_token_stride,
     output_hidden_stride,
     state_block_count,
+    token_groups,
     input_offset,
     state_offset,
     weight_offset,
@@ -135,9 +139,85 @@ protected:
             const int32_t output_token_stride = read_pitch(out_layout, 0);
             const int32_t output_hidden_stride = read_pitch(out_layout, 1);
 
+            // Token-tiling with an adaptive tiling factor G (see the .cl kernel for the
+            // per-work-item algorithm). The original kernel dispatched
+            // GWS={seq_count, hidden}, so at prefill only `hidden` work-items run, which
+            // is work-size-limited: it cannot fill the device's hardware-thread budget, so
+            // occupancy is capped below full. A fully token-parallel dispatch
+            // (GWS={seq,hidden,total_tokens}) reaches full occupancy but re-reads each
+            // token's K-element window from global memory, becoming memory-bound and a net
+            // regression on a bandwidth-limited integrated GPU. Instead, split each
+            // sequence into G contiguous token tiles (GWS dim 2 = token group); each
+            // (seq,h,g) work-item still streams its tile with a sliding window (no
+            // per-token redundant reads), so a small G lifts occupancy without the
+            // memory blow-up.
+            //
+            // G is chosen adaptively (not a hardcoded constant) from two axes:
+            //   (a) device scale — pick G so seq_count*hidden*G work-items oversubscribe
+            //       the device's hardware-thread budget
+            //       (execution_units_count * num_threads_per_eu) by ~1.5x, enough to hide
+            //       memory latency. A larger device (more EUs) gets a larger G
+            //       automatically; a smaller device gets less. This keeps the kernel
+            //       portable across device sizes without re-tuning.
+            //   (b) sequence length — keep every tile >= MIN_TILE_TOKENS so the one-time
+            //       K-1 window-priming reads per tile stay negligible vs the streamed work,
+            //       and never dispatch more tiles than there are tokens (decode, 1 token
+            //       per sequence, therefore falls back to G=1 = the original serial kernel).
+            // Override with OV_CONV1D_TOKEN_GROUPS=<n> to force G (unset/0 = auto). Set
+            // OV_CONV1D_DEBUG=1 to print the selected G once (diagnostic only).
+            const auto& dev_info = params.get_device_info();
+            const size_t total_tokens = static_cast<size_t>(input_shape[0].get_length());
             const size_t lws_y = std::min<size_t>(256, static_cast<size_t>(hidden_size));
             const size_t gws_y = ((static_cast<size_t>(hidden_size) + lws_y - 1) / lws_y) * lws_y;
-            wgs.global = {static_cast<size_t>(seq_count), gws_y, 1};
+
+            size_t token_groups = 0;  // 0 => auto-select below
+            if (const char* env = std::getenv("OV_CONV1D_TOKEN_GROUPS")) {
+                const int v = std::atoi(env);
+                if (v >= 1)
+                    token_groups = static_cast<size_t>(v);
+            }
+            if (token_groups == 0) {
+                constexpr size_t SIMD = 32;             // SIMD pack width assumed for this scalar kernel
+                constexpr size_t OVERSUB_NUM = 3;       // target 1.5x (= 3/2) oversubscription of the HW-thread budget
+                constexpr size_t OVERSUB_DEN = 2;
+                constexpr size_t MIN_TILE_TOKENS = 16;  // keep tiles long enough that per-tile K-1 priming reads stay negligible
+                constexpr size_t G_HARD_CAP = 64;       // safety cap for very large devices / tiny hidden
+
+                const size_t eu = static_cast<size_t>(dev_info.execution_units_count);
+                const size_t tpe = static_cast<size_t>(dev_info.num_threads_per_eu);
+                // Conservative fallback when the device does not report EU/thread counts.
+                const size_t hw_threads = (eu > 0 && tpe > 0) ? (eu * tpe) : 320;
+                const size_t target_wi = hw_threads * SIMD * OVERSUB_NUM / OVERSUB_DEN;
+
+                const size_t seqs = static_cast<size_t>(std::max(seq_count, 1));
+                const size_t wi_per_group = static_cast<size_t>(hidden_size) * seqs;  // work-items added by each token group
+                const size_t g_occ = (wi_per_group > 0) ? ((target_wi + wi_per_group - 1) / wi_per_group) : 1;  // ceil -> fill the GPU
+
+                const size_t avg_seq_len = (total_tokens > 0) ? std::max<size_t>(1, total_tokens / seqs) : 1;
+                const size_t g_len = std::max<size_t>(1, avg_seq_len / MIN_TILE_TOKENS);  // cap for short sequences
+
+                token_groups = std::min(std::min(g_occ, g_len), G_HARD_CAP);
+            }
+            // Never dispatch more groups than there are tokens; keep >= 1
+            // (clamp unconditionally so a forced env G is bounded even when total_tokens==0).
+            if (token_groups > total_tokens)
+                token_groups = total_tokens;
+            if (token_groups < 1)
+                token_groups = 1;
+
+            if (std::getenv("OV_CONV1D_DEBUG")) {
+                static bool logged = false;
+                if (!logged) {
+                    logged = true;
+                    fprintf(stderr,
+                            "[paged_causal_conv1d] EU=%u threads/EU=%u (HW threads=%u) | seq_count=%d hidden=%d total_tokens=%zu => token_groups(G)=%zu\n",
+                            dev_info.execution_units_count, dev_info.num_threads_per_eu,
+                            dev_info.execution_units_count * dev_info.num_threads_per_eu,
+                            seq_count, hidden_size, total_tokens, token_groups);
+                }
+            }
+
+            wgs.global = {static_cast<size_t>(seq_count), gws_y, token_groups};
             wgs.local = {1, lws_y, 1};
 
             kd.params.scalars.clear();
@@ -155,6 +235,7 @@ protected:
                 output_token_stride,
                 output_hidden_stride,
                 static_cast<int32_t>(params.get_input_layout(paged_causal_conv1d::CONV_STATE_TABLE).get_partial_shape()[0].get_length()),
+                static_cast<int32_t>(token_groups),
             };
 
             auto append_offset = [&scalars](const cldnn::layout& layout) {
