diff --git a/src/plugins/intel_gpu/src/graph/impls/ocl_v2/paged_gated_delta_net_opt.cl b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/paged_gated_delta_net_opt.cl
index 1d48cff..0765c94 100644
--- a/src/plugins/intel_gpu/src/graph/impls/ocl_v2/paged_gated_delta_net_opt.cl
+++ b/src/plugins/intel_gpu/src/graph/impls/ocl_v2/paged_gated_delta_net_opt.cl
@@ -43,6 +43,56 @@ inline void FUNC(normalize_kq_128)(float8* b_k, float8* b_q) {
 #endif
 }
 
+
+#ifndef GDN_RENORM_THRESHOLD
+#    define GDN_RENORM_THRESHOLD 1.0e-6f
+#endif
+
+#ifndef GDN_RENORM_UPPER
+#    define GDN_RENORM_UPPER 1.0e6f
+#endif
+
+// GDN_FAST_PATH (set by the host when K_HEAD_DIM == 8 * SUBGROUP_SIZE and the work-group of V_HEAD_DIM / V_BLOCK_SIZE
+// sub-groups is legal) selects the work-group cooperative kernel body below; otherwise the generic one is used.
+#ifndef GDN_FAST_PATH
+#    define GDN_FAST_PATH 0
+#endif
+#define GDN_CHUNK 4
+#define GDN_TOK_STRIDE (2 * K_HEAD_DIM + SUBGROUP_SIZE)
+#if FUSE_QK_L2NORM
+#    define GDN_FUSE_K_SCALE(sum) FUNC(l2norm_scale)((sum), 1.0f, K_L2_NORM_EPS)
+#    define GDN_FUSE_Q_SCALE(sum) FUNC(l2norm_scale)((sum), SCALE_FACTOR, Q_L2_NORM_EPS)
+#else
+#    define GDN_FUSE_K_SCALE(sum) 1.0f
+#    define GDN_FUSE_Q_SCALE(sum) SCALE_FACTOR
+#endif
+
+// Preprocess token (t_first + sg_id) of the current chunk (if it exists) into SLM buffer `bufi`:
+// L2-normalised q (scaled) and k as float, plus {k.q, exp(gate), beta}.
+#define GDN_PREPROCESS(t_first, seg_end_, bufi)                                                                          \
+    do {                                                                                                                 \
+        const int tk_ = (t_first) + sg_id;                                                                               \
+        if (sg_id < GDN_CHUNK && tk_ < (seg_end_)) {                                                                     \
+            float8 qr = convert_float8(BLOCK_READN(INPUT0_TYPE, 8, query, tk_ * q_token_stride + q_head_base));          \
+            float8 kr = convert_float8(BLOCK_READN(INPUT1_TYPE, 8, key, tk_ * k_token_stride + k_head_base));            \
+            float k_sum = FUNC(sum8)(kr * kr);                                                                           \
+            float q_sum = FUNC(sum8)(qr * qr);                                                                           \
+            float kq_sum = FUNC(sum8)(kr * qr);                                                                          \
+            k_sum = sub_group_reduce_add(k_sum);                                                                         \
+            q_sum = sub_group_reduce_add(q_sum);                                                                         \
+            kq_sum = sub_group_reduce_add(kq_sum);                                                                       \
+            const float k_scale_ = GDN_FUSE_K_SCALE(k_sum);                                                              \
+            const float q_scale_ = GDN_FUSE_Q_SCALE(q_sum);                                                              \
+            __local float* tb_ = gdn_slm + ((bufi) * GDN_CHUNK + sg_id) * GDN_TOK_STRIDE;                                \
+            BLOCK_WRITEN_SLM(float, 8, tb_, 0, qr * q_scale_);                                                           \
+            BLOCK_WRITEN_SLM(float, 8, tb_, K_HEAD_DIM, kr * k_scale_);                                                  \
+            const float g_ = exp(convert_float(gate[tk_ * V_HEAD_NUM + h]));                                             \
+            const float beta_ = convert_float(beta[tk_ * V_HEAD_NUM + h]);                                               \
+            const float m_ = lid == 0 ? kq_sum * k_scale_ * q_scale_ : (lid == 1 ? g_ : (lid == 2 ? beta_ : 0.0f));      \
+            BLOCK_WRITEN_SLM(float, 1, tb_, 2 * K_HEAD_DIM, m_);                                                         \
+        }                                                                                                                \
+    } while (0)
+
 #ifndef K_VEC_SIZE
 #    define K_VEC_SIZE 1
 #endif
@@ -123,6 +173,100 @@ KERNEL(paged_gated_delta_net_opt)
     const int v_head_base = (h + value_head_offset) * v_head_stride;
     const int state_stride = K_HEAD_DIM * V_HEAD_DIM;
 
+
+#if GDN_FAST_PATH
+    // ---- work-group cooperative fast path ----------------------------------------------------------------------------
+    // One work-group = one (sequence, head) and holds V_HEAD_DIM / V_BLOCK_SIZE sub-groups; each sub-group owns
+    // V_BLOCK_SIZE rows of the [V_HEAD_DIM x K_HEAD_DIM] state, one float8 per row and lane.
+    //  * The per-token, per-head work that does not depend on the state (q/k load + L2 norm, q.k, exp(gate), beta) is done
+    //    once per work-group, GDN_CHUNK tokens at a time by different sub-groups, and handed to the others through SLM.
+    //  * The state is kept as S_true = c * S with a scalar c, so the decay only touches c, and the delta rule is rearranged so
+    //    that both dot products use the old state:  a = S.k, b = S.q,  u = (v - c' a) * beta (c' = c g),
+    //    S += (u / c') k,  out = c' b + u (k.q).  S is renormalised (S *= c', c = 1) if c' leaves [GDN_RENORM_THRESHOLD, GDN_RENORM_UPPER].
+    __local float gdn_slm[2 * GDN_CHUNK * GDN_TOK_STRIDE];
+    const int sg_id = get_local_id(2) / SUBGROUP_SIZE;
+    const int sg_start_iv = sg_id * V_BLOCK_SIZE;
+    float8 S[V_BLOCK_SIZE];
+    {
+        const int base0 = (block_indices[block_begin] * V_HEAD_NUM + h) * state_stride;
+#    pragma unroll
+        for (int r = 0; r < V_BLOCK_SIZE; r++)
+            S[r] = convert_float8(BLOCK_READN(INPUT3_TYPE, 8, recurrent_state_table, base0 + (sg_start_iv + r) * K_HEAD_DIM));
+    }
+    float c_scale = 1.0f;
+
+    int token_f = token_begin;
+    int slot_f = 1;
+    int to_boundary_f = interval > 0 ? (prev_nums > 0 ? (interval - prev_nums) : interval) : (token_end - token_begin);
+    while (token_f < token_end) {
+        const int seg_end = min(token_f + to_boundary_f, token_end);
+
+        // prologue: preprocess the first chunk of the segment into buffer 0
+        GDN_PREPROCESS(token_f, seg_end, 0);
+        barrier(CLK_LOCAL_MEM_FENCE);
+
+        int buf = 0;
+        for (int t0 = token_f; t0 < seg_end; t0 += GDN_CHUNK) {
+            const int n_tok = min(GDN_CHUNK, seg_end - t0);
+            if (t0 + GDN_CHUNK < seg_end)
+                GDN_PREPROCESS(t0 + GDN_CHUNK, seg_end, buf ^ 1);
+
+            for (int j = 0; j < n_tok; j++) {
+                const int tk = t0 + j;
+                const __local float* tb = gdn_slm + (buf * GDN_CHUNK + j) * GDN_TOK_STRIDE;
+                const float8 qv = BLOCK_READN_SLM(float, 8, tb, 0);
+                const float8 kv = BLOCK_READN_SLM(float, 8, tb, K_HEAD_DIM);
+                const float misc = BLOCK_READN_SLM(float, 1, tb, 2 * K_HEAD_DIM);
+                const float kq = sub_group_broadcast(misc, 0);
+                const float b_g = sub_group_broadcast(misc, 1);
+                const float b_beta = sub_group_broadcast(misc, 2);
+
+                float c_new = c_scale * b_g;
+                if (c_new < GDN_RENORM_THRESHOLD || c_new > GDN_RENORM_UPPER) {
+#    pragma unroll
+                    for (int r = 0; r < V_BLOCK_SIZE; r++)
+                        S[r] *= c_new;
+                    c_new = 1.0f;
+                }
+                const float inv_c = 1.0f / c_new;
+
+                float a_part[V_BLOCK_SIZE];
+                float b_part[V_BLOCK_SIZE];
+#    pragma unroll
+                for (int r = 0; r < V_BLOCK_SIZE; r++) {
+                    a_part[r] = FUNC(sum8)(S[r] * kv);
+                    b_part[r] = FUNC(sum8)(S[r] * qv);
+                }
+                const float v_all = convert_float(BLOCK_READN(INPUT2_TYPE, 1, value, tk * v_token_stride + v_head_base + (sg_start_iv & ~(SUBGROUP_SIZE - 1))));
+                float out_sel = 0.0f;
+#    pragma unroll
+                for (int r = 0; r < V_BLOCK_SIZE; r++) {
+                    const float a = sub_group_reduce_add(a_part[r]);
+                    const float b = sub_group_reduce_add(b_part[r]);
+                    const float v_r = sub_group_broadcast(v_all, (sg_start_iv & (SUBGROUP_SIZE - 1)) + r);
+                    const float u = (v_r - c_new * a) * b_beta;
+                    S[r] = fma(kv, u * inv_c, S[r]);
+                    out_sel = (lid == r) ? (c_new * b + u * kq) : out_sel;
+                }
+                if (lid < V_BLOCK_SIZE)
+                    output[(tk * V_HEAD_NUM + h) * V_HEAD_DIM + sg_start_iv + lid] = TO_OUTPUT_TYPE(out_sel);
+                c_scale = c_new;
+            }
+            buf ^= 1;
+            barrier(CLK_LOCAL_MEM_FENCE);
+        }
+        token_f = seg_end;
+
+        const int block_base_f = (block_indices[block_begin + slot_f] * V_HEAD_NUM + h) * state_stride;
+        slot_f++;
+#    pragma unroll
+        for (int r = 0; r < V_BLOCK_SIZE; r++)
+            BLOCK_WRITEN(INPUT3_TYPE, 8, recurrent_state_table, block_base_f + (sg_start_iv + r) * K_HEAD_DIM, K_VEC_TO_STATE(S[r] * c_scale));
+        if (interval > 0)
+            to_boundary_f = interval;
+    }
+    return;
+#endif
     K_VEC_TYPE state[V_BLOCK_SIZE][K_VEC_COUNT];
     K_VEC_TYPE q_norm[K_VEC_COUNT];
     K_VEC_TYPE k_norm[K_VEC_COUNT];
