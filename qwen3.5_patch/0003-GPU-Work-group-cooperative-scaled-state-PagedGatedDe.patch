+// Work-group cooperative kernel body (see paged_gated_delta_net_opt.cl, GDN_FAST_PATH): V_HEAD_DIM / V_BLOCK_SIZE sub-groups
+// share one (sequence, head) work-group. It needs at least GDN_CHUNK (4) sub-groups and one float8 of K per lane.
+constexpr size_t gdn_coop_v_block_size = 8;
+constexpr size_t gdn_coop_chunk = 4;
+constexpr size_t gdn_coop_slm_bytes = 2 * gdn_coop_chunk * (2 * 128 + 16) * sizeof(float);
