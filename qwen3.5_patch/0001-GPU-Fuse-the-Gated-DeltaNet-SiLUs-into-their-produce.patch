 #include <limits>
 
+#include "intel_gpu/primitives/activation.hpp"
 #include "intel_gpu/primitives/paged_causal_conv1d.hpp"
 #include "primitive_ocl_base.hpp"
 #include "utils/kernel_generator.hpp"
@@ -59,6 +60,20 @@ protected:
         jit.make("KERNEL_SIZE", static_cast<int>(state_shape[2].get_length()));
         jit.make("HAS_BIAS", has_bias ? 1 : 0);
 
+        // A SWISH activation fused by prepare_primitive_fusing (Qwen3.5 / Gated-DeltaNet
+        // applies SiLU to the conv output). Applying it in the conv epilogue removes a
+        // full read+write pass over the [tokens, hidden] output. Only the single-SWISH
+        // case is accepted here, matching the guard in prepare_primitive_fusing; anything
+        // else leaves the activation as its own node, so an unhandled fusion can never be
+        // silently dropped.
+        if (params.has_fused_primitives() && params.fused_desc.size() == 1 && params.fused_desc[0].is_type<cldnn::activation>()) {
+            const auto act = params.fused_desc[0].typed_desc<cldnn::activation>();
+            if (act->activation_function == cldnn::activation_func::swish) {
+                jit.make("FUSE_SWISH", 1);
+                jit.make("FUSE_SWISH_BETA", act->additional_params.a);
+            }
+        }
+
         return jit;
     }
 
diff --git a/src/plugins/intel_gpu/src/plugin/transformations/move_swish_up_through_reshape.cpp b/src/plugins/intel_gpu/src/plugin/transformations/move_swish_up_through_reshape.cpp
new file mode 100644
index 0000000..fababca
--- /dev/null
+++ b/src/plugins/intel_gpu/src/plugin/transformations/move_swish_up_through_reshape.cpp
@@ -0,0 +1,76 @@
+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+#include "move_swish_up_through_reshape.hpp"
+
+#include "openvino/core/graph_util.hpp"
+#include "openvino/core/rt_info.hpp"
+#include "openvino/op/reshape.hpp"
+#include "openvino/op/swish.hpp"
+#include "openvino/pass/pattern/op/wrap_type.hpp"
+#include "transformations/utils/utils.hpp"
+
+namespace ov::intel_gpu {
+
+MoveSwishUpThroughReshape::MoveSwishUpThroughReshape() {
+    using namespace ov::pass::pattern;
+
+    auto reshape_m = wrap_type<ov::op::v1::Reshape>(consumers_count(1));
+    auto swish_m = wrap_type<ov::op::v4::Swish>({reshape_m, any_input()});
+    auto swish_no_beta_m = wrap_type<ov::op::v4::Swish>({reshape_m});
+    auto root_m = std::make_shared<ov::pass::pattern::op::Or>(ov::OutputVector{swish_m, swish_no_beta_m});
+
+    matcher_pass_callback callback = [=](Matcher& m) {
+        const auto& pattern_map = m.get_pattern_value_map();
+        auto swish = ov::as_type_ptr<ov::op::v4::Swish>(m.get_match_root());
+        auto reshape = ov::as_type_ptr<ov::op::v1::Reshape>(pattern_map.at(reshape_m).get_node_shared_ptr());
+        if (!swish || !reshape) {
+            return false;
+        }
+
+        // consumers_count(1) already guarantees the Reshape feeds only this Swish, so no
+        // other consumer can observe the pre-activation values.
+        if (transformation_callback(swish)) {
+            return false;
+        }
+
+        // Hoisting over a PagedCausalConv1D producer lands the Swish in the conv's OCL epilogue,
+        // which reproduces the un-fused rounding exactly (round to f16, then SiLU in f16).
+        //
+        // Hoisting over a FullyConnected producer (the `in_proj_z` gate) instead turns the
+        // Swish into a oneDNN eltwise_swish post-op evaluated on the f32 GEMM accumulator. That
+        // is MORE accurate than the f16 standalone kernel but not bit-identical; it removes the
+        // last standalone SiLU pass (~3.6 ms of a 1k-token 2B prefill on Pantherlake) and is
+        // enabled by default here. OV_SWISH_HOIST_PRODUCER_ONLY=1 restores the conv-only behaviour.
+        const bool hoist_all = std::getenv("OV_SWISH_HOIST_PRODUCER_ONLY") == nullptr;
+        if (!hoist_all) {
+            const auto producer = reshape->input_value(0).get_node_shared_ptr();
+            if (producer->get_type_info().name != std::string("PagedCausalConv1D")) {
+                return false;
+            }
+        }
+
+        // Rebuild as Reshape(Swish(x)). The Swish takes the Reshape's data input; its beta
+        // input, when present, is a scalar and is carried over untouched.
+        ov::OutputVector swish_inputs{reshape->input_value(0)};
+        if (swish->get_input_size() > 1) {
+            swish_inputs.push_back(swish->input_value(1));
+        }
+        auto new_swish = swish->clone_with_new_inputs(swish_inputs);
+        new_swish->set_friendly_name(swish->get_friendly_name() + "_hoisted");
+
+        auto new_reshape = reshape->clone_with_new_inputs({new_swish, reshape->input_value(1)});
+        new_reshape->set_friendly_name(swish->get_friendly_name());
+
+        ov::copy_runtime_info({reshape, swish}, {new_swish, new_reshape});
+        ov::replace_node(swish, new_reshape);
+
+        return true;
+    };
+
+    auto m = std::make_shared<Matcher>(root_m, "MoveSwishUpThroughReshape");
+    this->register_matcher(m, callback);
+}
+
+}  // namespace ov::intel_gpu
diff --git a/src/plugins/intel_gpu/src/plugin/transformations/move_swish_up_through_reshape.hpp b/src/plugins/intel_gpu/src/plugin/transformations/move_swish_up_through_reshape.hpp
new file mode 100644
index 0000000..c6677f7
--- /dev/null
+++ b/src/plugins/intel_gpu/src/plugin/transformations/move_swish_up_through_reshape.hpp
@@ -0,0 +1,35 @@
+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+#pragma once
+
+#include "openvino/pass/matcher_pass.hpp"
+
+namespace ov::intel_gpu {
+
+/// \brief Hoists a Swish (SiLU) above a single-consumer Reshape.
+///
+/// Rewrites `Swish(Reshape(x))` into `Reshape(Swish(x))`. Swish is elementwise and a
+/// Reshape only re-indexes, so this is value-for-value identical -- it changes nothing
+/// numerically, only which node the activation is adjacent to.
+///
+/// Motivation: in Qwen3.5 / Gated-DeltaNet the SiLU that follows the causal conv is
+/// separated from its producer by a Reshape that PagedCausalConv1DFusion inserts to
+/// restore the 3D shape. The same shape holds for the `in_proj_z` gate. The GPU plugin's
+/// prepare_primitive_fusing only fuses an activation into its *direct* dependency, so that
+/// interposed Reshape is what keeps the SiLU as a standalone kernel -- one that re-reads
+/// and re-writes the whole activation tensor at the device's memory-bandwidth ceiling.
+/// Hoisting the Swish makes it adjacent to the conv / FullyConnected again so the existing
+/// fusing pass can absorb it.
+///
+/// ov::pass::MoveEltwiseUpThroughDataMov does not cover this: it matches
+/// UnaryElementwiseArithmetic / BinaryElementwiseArithmetic, and ov::op::v4::Swish derives
+/// from ov::op::Op directly (it takes an optional beta input), so it is never matched.
+class MoveSwishUpThroughReshape : public ov::pass::MatcherPass {
+public:
+    OPENVINO_MATCHER_PASS_RTTI("MoveSwishUpThroughReshape");
+    MoveSwishUpThroughReshape();
+};
+
+}  // namespace ov::intel_gpu
